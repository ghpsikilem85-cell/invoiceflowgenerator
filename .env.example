# Public site URL (used for canonical URLs, sitemap, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (optional for MVP — auth/save/dashboard degrade gracefully when unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" only after enabling the Google provider in Supabase and
# creating an OAuth client in Google Cloud. Otherwise the button is hidden.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Google AdSense (optional). Ads, ads.txt and the advertising section of the
# privacy policy all stay switched off until the client ID is set.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=

# Public contact address shown on /contact, /about and the privacy policy.
NEXT_PUBLIC_CONTACT_EMAIL=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# AI tools (optional — /dashboard/ai degrades gracefully when unset)
ANTHROPIC_API_KEY=
# Gate the AI tools behind a paid plan. Leave false until Stripe billing exists.
AI_REQUIRE_PRO=false

# Stripe billing (optional — /pricing shows "Coming soon" when unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=

# Supabase secret key — server only, bypasses RLS. Required by the Stripe
# webhook, which arrives with no user session. Never prefix this with
# NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SECRET_KEY=
